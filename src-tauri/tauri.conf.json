{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZVideoConverter",
  "version": "0.1.0",
  "identifier": "com.zlogic.zvideoconverter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZVideoConverter",
        "width": 1480,
        "height": 920,
        "minWidth": 1180,
        "minHeight": 720,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#0A0A09",
        "resizable": true,
        "dragDropEnabled": true,
        "center": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Bulk video converter with GPU acceleration",
    "longDescription": "ZVideoConverter converts whole folders of video in one clean window. It uses NVIDIA NVENC, AMD AMF / VA-API and Intel Quick Sync when available, falls back to the CPU automatically, lets you edit your profiles in place, and keeps every file name intact, dots, brackets and all. Free and open source (GPL-3.0) by TheHolyOneZ.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [],
        "desktopTemplate": "desktop-entry.desktop"
      },
      "rpm": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "publisher": "TheHolyOneZ",
    "homepage": "https://zsync.eu/zvideoconverter/",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright (c) 2026 TheHolyOneZ. Licensed under the GPL-3.0.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "German"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "mainBinaryName": "zvideoconverter",
  "plugins": {
    "opener": {
      "requireLiteralLeadingDot": false
    }
  }
}
